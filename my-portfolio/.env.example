# Server-only (no VITE_ prefix, so it never ships to the browser)
GROQ_API_KEY=

# Token budget for model answers (all optional; defaults shown)
# CHAT_IP_TOKEN_LIMIT=30000        # per visitor IP, per window
# CHAT_IP_WINDOW_HOURS=24          # window starts at the visitor's first message
# CHAT_GLOBAL_TOKEN_LIMIT=150000   # all visitors combined, per UTC day (Groq free tier: 200K/day)
# CHAT_IP_REQUESTS_PER_MIN=8
# CHAT_IP_SALT=change-me           # salts the IP hash; IPs are never stored raw
# CHAT_LOG_QUESTIONS=off           # stop logging AI questions (on by default; read with `npm run questions`)

# Upstash Redis (Vercel Marketplace → Upstash for Redis sets these automatically).
# Without them, quotas are in-memory only — fine locally, not enforced on Vercel.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
